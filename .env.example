# Autenticação desta turma: Google ADC (não use GOOGLE_API_KEY).
#   gcloud auth application-default login
#   gcloud config set project spartan-setting-485114-e3
#
# Copie este arquivo para .env na raiz do repositório e preencha a letra do grupo.
# Tutorial: docs/aula-04-gcs-e-vector-search/

GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=spartan-setting-485114-e3
GOOGLE_CLOUD_LOCATION=us-east1

# Deixe desligado nesta aula (sessão em memória).
# USE_VERTEX_SESSION=0

# --- Parte B (Vector Search). Comente na Parte A (Chroma local). ---
# Substitua X pela letra do grupo. Cole os IDs numéricos do Console (us-east1).
# VECTOR_SEARCH_GCS_BUCKET=rag-spartan-bv2-grupo-X
# VECTOR_SEARCH_INDEX_ID=
# VECTOR_SEARCH_ENDPOINT_ID=
# VECTOR_SEARCH_DEPLOYED_INDEX_ID=
# ↑ campo "id" do índice implantado (gcloud ai index-endpoints describe), NÃO o displayName
